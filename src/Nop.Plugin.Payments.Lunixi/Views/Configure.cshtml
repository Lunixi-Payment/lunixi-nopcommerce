@model ConfigurationModel
@{ Layout = "_ConfigurePlugin"; }
<img src="~/Plugins/Payments.Lunixi/Assets/lunixi-logo.svg" alt="Lunixi" width="200" />
<p>@T("Plugins.Payments.Lunixi.Methods")</p>
<p>@T("Plugins.Payments.Lunixi.ServerKey")</p>
@if (!Model.ServerKeyConfigured) { <div class="alert alert-warning">@T("Plugins.Payments.Lunixi.ServerKeyMissing")</div> }
<form asp-controller="PaymentLunixi" asp-action="Configure" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group"><label><input asp-for="Enabled" /> @T("Plugins.Payments.Lunixi.Enabled")</label></div>
    <div class="form-group"><label>@T("Plugins.Payments.Lunixi.MerchantId")</label><input asp-for="MerchantId" class="form-control" maxlength="256" autocomplete="off" /></div>
    <div class="form-group"><label>@T("Plugins.Payments.Lunixi.KeyId")</label><input asp-for="KeyId" class="form-control" maxlength="512" autocomplete="off" /></div>
    <div class="form-group"><label>@T("Plugins.Payments.Lunixi.PrivateKey")</label><textarea name="PrivateKeyPem" class="form-control" maxlength="16384" autocomplete="off" spellcheck="false"></textarea></div>
    <div class="form-group"><label>@T("Plugins.Payments.Lunixi.WebhookSecret")</label><input name="WebhookSecret" type="password" class="form-control" maxlength="4096" autocomplete="new-password" value="" /></div>
    <p>@T("Plugins.Payments.Lunixi.SecretHint")</p>
    <div class="form-group"><label><input asp-for="Hosted" /> @T("Plugins.Payments.Lunixi.Hosted")</label></div>
    <div class="form-group"><label><input asp-for="Preauthorize" /> @T("Plugins.Payments.Lunixi.Preauthorize")</label></div>
    <div class="form-group"><label>@T("Plugins.Payments.Lunixi.WebhookUrl")</label><input value="@Model.WebhookUrl" readonly class="form-control" /></div>
    <button type="submit" class="btn btn-primary">@T("Admin.Common.Save")</button>
</form>
<p>@T("Plugins.Payments.Lunixi.Preserved")</p>
