<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nop.Plugin.Payments.Lunixi/Nop.Plugin.Payments.Lunixi.csproj" Private="false" />
    <PackageReference Include="Lunixi.Sdk" Version="$(LunixiSdkVersion)" Condition="'$(UseLunixiSdkPackage)' == 'true'" />
    <ProjectReference Include="$(LunixiSdkProject)" Condition="'$(UseLunixiSdkPackage)' != 'true'" />
  </ItemGroup>
</Project>
